# Node
node_modules/

# Built web root (regenerated by `npm run build` in CI)
www/

# Android build outputs (the wrapper jar + gradle files ARE committed; only
# outputs are ignored — see android/.gitignore for the per-module rules)
out/
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/capacitor-cordova-android-plugins/

# OS / editor
.DS_Store
*.log
.idea/
*.iml

# Throwaway keystores must never be committed
*.jks
*.keystore
